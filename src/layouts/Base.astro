---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, SITE_NAME, NOINDEX } from '../utils/constants';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
}

const { title, description, ogImage, canonical } = Astro.props;
const siteUrl = SITE_URL;
const pageUrl = canonical || new URL(Astro.url.pathname, SITE_URL).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="3BySvleUOYq7XfeNHuNuc1Ec4ObgYeT0wc-L7MeVKyw" />

    {/* Temporary while the site is unfinished. Controlled by NOINDEX in src/utils/constants.ts */}
    {NOINDEX && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={SITE_NAME} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Canonical: always emitted, never optional -->
    <link rel="canonical" href={pageUrl} />
  </head>

  <body class="bg-white text-gray-900">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
